# Dependencies (regenerate with `npm install`)
node_modules/

# electron-builder output (installers, unpacked build) — built with
# `npm run dist`, not something to commit; see GitHub Releases instead.
dist/

# Your real Battlepass data — personal to you, not shared. Everyone who
# clones this needs to fill in their own copy; see
# data-source/battlepass.template.xlsx / .template.csv and
# scripts/generate-template.js. (The real files actually live in
# %APPDATA%\TarkovBattlepassTracker\, never in this folder — these two
# entries are just a defensive backstop in case a real copy ever ends up
# here anyway.)
data-source/battlepass.xlsx
data-source/battlepass.csv

# Personal machine-specific shortcut(s), not portable to other machines.
*.lnk

# OS cruft
.DS_Store
Thumbs.db

# Claude Code's running dev-notes file for this project — a session-by-session
# log of requests and changes, useful for picking up work again but not meant
# for a public repo (long, informal, not written for an audience).
CLAUDE.md
